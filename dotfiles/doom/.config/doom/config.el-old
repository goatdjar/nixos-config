;; LSP Mode
(after! lsp-mode
  (setq lsp-idle-delay 0.5)         ;; Default is often 0.1 or 0.2. Raising to 0.5 helps a lot.
  (setq lsp-before-save-edits nil)) ;; Prevents LSP from modifying the buffer file right before saving it,
;; letting Doom's standard formatting hooks handle it cleanly.

(after! projectile
  (add-to-list 'projectile-project-root-files "pyproject.toml")
  (add-to-list 'projectile-project-root-files "uv.lock"))


;; project specific configuration
;; set default directory for quick run on project root
;; (add-hook 'find-file-hook
;;           (lambda ()
;;             (when-let ((project-root (projectile-project-root)))
;;               (setq default-directory project-root))))

;; quick run
(map! :leader
      (:prefix-map ("r" . "run")
       :desc "Run current file" "r" #'quickrun))

;; adjusts pane(s)
;; window manipulation / micro-state
(define-prefix-command 'my-window-resize-map)
(define-key my-window-resize-map (kbd "<") (lambda () (interactive) (shrink-window-horizontally -3) (set-transient-map my-window-resize-map t)))
(define-key my-window-resize-map (kbd ">") (lambda () (interactive) (shrink-window-horizontally 3)  (set-transient-map my-window-resize-map t)))
(define-key my-window-resize-map (kbd "+") (lambda () (interactive) (enlarge-window 3)              (set-transient-map my-window-resize-map t)))
(define-key my-window-resize-map (kbd "-") (lambda () (interactive) (enlarge-window -3)             (set-transient-map my-window-resize-map t)))
;; Now you can effortlessly tap >, <, +, or - repeatedly to size your splits. Press ESC to quit.
(map! :leader
      :desc "Resize mode"
      "w ." (lambda () (interactive) (set-transient-map my-window-resize-map t)))

;; silence keystrokes
(setq echo-keystrokes 0)

;; Force the quickrun output window to pop up at the bottom and take focus
;; (set-popup-rule! "^\\*quickrun\\*" :side 'bottom :size 0.4 :ttl nil :quit t :select t)
;; Configure async terminal to popup on the right side of the sceren.
;; (set-popup-rule! "^\\*doom:vterm" :side 'right :size 0.4 :quit nil :ttl nil)

;; Helpful shortcuts for Python Debugging
;; ---
;; SPC o r or M-x +python/open-repl: Opens a persistent Python REPL side-window.
;; SPC o r
;; ---
;; Send python code to REPL
;; SPC c e
;; ---
;; Quickly cycle your cursor back and forth between your code and the REPL window.
;; C-w w
;; If you ever want to quickly clear the REPL buffer when it gets cluttered with old inputs.
;; SPC c p
